# First Profit SPA environment variables.
# Copy to .env.local and fill in real values. All three are required at
# runtime boot; the app fails fast with a clear error if any is missing.

# Shared Supabase project (same project as The120). Legacy anon JWT key style.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Base URL of The120 deployment hosting /api/fp/* routes.
VITE_T120_API_URL=https://the120.school

# Start Building CTA cutover flag (Slice B, Plan Revision 11 — "no half-live
# window"). OPTIONAL; defaults OFF. When unset/false the Landing CTA routes to
# `login` (Slice A behavior); set to "true" ONLY after the [T120] signup backend
# is verified live to repoint the CTA to the in-app signup flow. This flip is the
# deliberate, reversible go-live step for Slice B signup.
# VITE_ENABLE_SIGNUP=false

# ---------------------------------------------------------------------------
# SERVER-side env for the public-site Vercel Function (api/site.ts — real
# public site, plan Unit 3). These are read by the function at runtime via
# process.env and must be set in the Vercel project environment (NOT the
# VITE_* client-bundle vars above, which must never be the function's source).
# Same shared Supabase project; the anon key is enough — the function only
# calls the SECURITY DEFINER RPC fp_public_site(handle). If either is missing
# the function serves the "temporarily unavailable" 503 page, never an error
# detail.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
